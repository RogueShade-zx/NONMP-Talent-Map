    {
      "id": 1501,
      "name": "Radiant Blade",
      "type": "Common",
      "state": "LightUp",
      "x": 157.99998,
      "y": -253.99998,
      "image": "Radiant Blade.png",
      "Desc": "*After combat begins, this skill enters Cooldown.<br><br>Lilith moves to the front of the team and points her sword at the enemy, taunting all enemy characters. All allies except Lilith gain Physical Shield equal to 200 + 10% / 20% / 30% of Lilith's max HP, and gain 20% / 30% / 40% ATK bonus for 2 turns.<br><br>Additionally, when an ally's attack hits, Lilith performs a follow-up attack dealing Magic DMG equal to 50% / 75% / 100% ATK to the main target for 2 turns. After follow-up attack deals damage, all allies gain Magic Shield equal to 30% / 40% / 50% of damage dealt for 1 turn.",
      "NumericDesc": "Base Shield：200 / 200 / 200<br>Max HP Shield：10% / 20% / 30%<br>ATK Bonus: 20% / 30% / 40%<br>DMG to Shield %：30% / 40% / 50%<br>Range：Unlimited<br>Follow-up ATK %：50% / 75% / 100%<br>Cooldown：6 turns<br>Sanity Cost：50 / 100 / 150",
      "Story": "When Lilith steps forward with blade aimed at the enemy, the battlefield's gravity shifts toward her.<br>\"Don't worry about your back, Guildmaster—my sword sees all directions.\"",
      "lvl1cost": "<img src=\"images\\Gold.png\"> Gold: 100",
      "lvl2cost": "<img src=\"images\\Gold.png\"> Gold: 300",
      "lvl3cost": "<img src=\"images\\Gold.png\"> Gold: 800 <br> <img src=\"images\\Dark Crystal.png\"> Dark Crystal: 1"
    },
    {
      "id": 1401,
      "name": "Piercing Shadow Thrust",
      "type": "Common",
      "state": "LightUp",
      "x": 264.99997,
      "y": -150,
      "image": "Piercing Shadow Thrust.png",
      "Desc": "Lilith launches a swift thrust at enemies, dealing Physical DMG equal to 50% / 75% / 100% ATK to all targets within range. Also applies \"Bleed\" to them for 2 turns.<br>",
      "NumericDesc": "\"Bleed\" stacks：5 / 7 / 9<br>Range：2,3,4<br>Physical DMG ATK %：50% / 75% / 100%<br>Cooldown：2 turns<br>Sanity Cost：25 / 35 / 50",
      "Story": "Lilith's charge becomes a fleeting shadow, her blade slithering like a viper.<br>\"Let the wounds speak for us—some foes need time to realize they've lost.\"",
      "lvl1cost": "<img src=\"images\\Gold.png\"> Gold: 100",
      "lvl2cost": "<img src=\"images\\Gold.png\"> Gold: 300",
      "lvl3cost": "<img src=\"images\\Gold.png\"> Gold: 800 <br> <img src=\"images\\Dark Crystal.png\"> Dark Crystal: 1"
    },
    {
      "id": 1301,
      "name": "Battle Resonance",
      "type": "Common",
      "state": "LightUp",
      "x": 304.99997,
      "y": -23,
      "image": "Battle Resonance.png",
      "Desc": "Select an ally, placing them in \"Protected\" state and applying \"Purify\", while both gain ATK bonus equal to 20% / 30% / 40% of each other's base ATK for 3 turns.<br>Also, when the target is attacked, it may trigger \"Parry\" counterattack; counter trigger chance is based on \"Parry\" level.<br>",
      "NumericDesc": "Base ATK Share %：20% / 30% / 40%<br>Cooldown：3 turns<br>Sanity Cost：30 / 50 / 70",
      "Story": "In Lilith's eyes, true synergy isn't just sharing power—it's understanding each other's every move.<br>\"Don't rely on this too much, okay? Keep training.\"",
      "lvl1cost": "<img src=\"images\\Gold.png\"> Gold: 100",
      "lvl2cost": "<img src=\"images\\Gold.png\"> Gold: 300",
      "lvl3cost": "<img src=\"images\\Gold.png\"> Gold: 800 <br> <img src=\"images\\Dark Crystal.png\"> Dark Crystal: 1"
    },
