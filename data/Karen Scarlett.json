    {
      "id": 2501,
      "name": "Nemesis",
      "type": "Common",
      "state": "LightUp",
      "x": 157.99998,
      "y": -253.99998,
      "image": "Nemesis.png",
      "Desc": "*After combat begins, this skill enters Cooldown.<br><br>Usable when enemy units have a total of 5 stacks of \"Enmity\".<br>Self and the ally with highest current HP lose 20% of current HP, entering \"Nemesis\" state to fight with deadly resolve for 2 turns. Also replaces this skill with \"Final Scythe Bloom\".<br><br>\"Nemesis\"<br>Has \"Overdrive\" state.<br>Speed increased by 10% / 20% / 30%, ATK increased by 10% / 20% / 30%, CRIT Rate increased by 10% / 20% / 30%, CRIT DMG increased by 30%.<br>When duration ends, Karen immediately falls.<br>",
      "NumericDesc": "Speed Increase：10% / 20% / 30%<br>ATK Increase：10% / 20% / 30%<br>CRIT Rate Increase：10% / 20% / 30%<br>CRIT DMG Increase：30%<br>Max HP Cost：20%<br>Cooldown：3 turns<br>Sanity Cost：50 / 100 / 150",
      "Story": "Mother's comb, hometown's smoke, cries swallowed by mist—now she's no longer a liability, but the embodiment of all departed wishes.<br>\"This is the end—enough to sever everything!\"",
      "lvl1cost": "<img src=\"images\\Gold.png\"> Gold: 100",
      "lvl2cost": "<img src=\"images\\Gold.png\"> Gold: 300",
      "lvl3cost": "<img src=\"images\\Gold.png\"> Gold: 800 <br> <img src=\"images\\Dark Crystal.png\"> Dark Crystal: 1"
    },
    {
      "id": 2401,
      "name": "Phantom Wheel Slash",
      "type": "Common",
      "state": "LightUp",
      "x": 264.99997,
      "y": -150,
      "image": "Phantom Wheel Slash.png",
      "Desc": "Karen and the ally with highest current HP lose 10% of current HP and Sanity, then Karen throws her scythe, dealing Physical DMG equal to 50% / 70% / 90% ATK to all units within attack range, and applying \"2\" × \"Enmity stacks\" stacks of \"Vulnerability\" for 1 turn.<br>",
      "NumericDesc": "Range：2,3<br>Physical DMG ATK %：50% / 70% / 90%<br>Cooldown：2 turns<br>Sanity Cost：30 / 70 / 110",
      "Story": "Karen never shies from the cost. Only searing pain keeps hatred sharp.<br>\"If you dare come close, share this burden with me.\"",
      "lvl1cost": "<img src=\"images\\Gold.png\"> Gold: 100",
      "lvl2cost": "<img src=\"images\\Gold.png\"> Gold: 300",
      "lvl3cost": "<img src=\"images\\Gold.png\"> Gold: 800 <br> <img src=\"images\\Dark Crystal.png\"> Dark Crystal: 1"
    },
    {
      "id": 2301,
      "name": "Assimilation",
      "type": "Common",
      "state": "LightUp",
      "x": 304.99997,
      "y": -23,
      "image": "Assimilation.png",
      "Desc": "Karen selects another ally, strengthening the team at the cost of Sanity. Karen and the ally with highest Sanity lose 20% of current Sanity, then grants self and target \"Purify\" and \"Shadow Form\" for 2 turns.<br><br>\"Shadow Form\"<br>ATK and Evasion increased by 20% / 30% / 40%, and can target enemies in \"Stealth\" state.<br>Additionally, removes attack range limit from \"Soul Severing Slash\".<br>Casting skills immediately ends \"Shadow Form\".<br>",
      "NumericDesc": "ATK Increase：20% / 30% / 40%<br>Evasion Increase：20% / 30% / 40%<br>Cooldown：3 turns<br>Sanity Cost：60 / 100 / 140",
      "Story": "When the battle tips, Karen glances aside.<br>Trading reason for edge... Will you fall into this shadow with me?",
      "lvl1cost": "<img src=\"images\\Gold.png\"> Gold: 100",
      "lvl2cost": "<img src=\"images\\Gold.png\"> Gold: 300",
      "lvl3cost": "<img src=\"images\\Gold.png\"> Gold: 800 <br> <img src=\"images\\Dark Crystal.png\"> Dark Crystal: 1"
    },
    {
      "id": 2201,
      "name": "Soul Severing Slash",
      "type": "Common",
      "state": "LightUp",
      "x": 269,
      "y": 116.99999,
      "image": "Soul Severing Slash.png",
      "Desc": "Karen strengthens herself at the cost of HP. Karen and the ally with the highest current HP lose 10% of current HP. Then Karen swings her scythe at a target, dealing Physical DMG equal to 80% + (30% / 40% / 50% ATK × target's Enmity stacks). The ally with lowest HP (excluding self) recovers HP equal to 10% of damage dealt.",
      "NumericDesc": "Current HP Loss：10%<br>Healing %：10%<br>Range：1,2<br>Physical DMG ATK：80% + 30% / 40% / 50%<br>Cooldown：1 turn<br>Sanity Cost：10 / 20 / 30",
      "Story": "This slash carries all her hatred, as if witnessing that great fire and the lonely girl amid the ruins.<br>\"Pain is the price of staying lucid.\"",
      "lvl1cost": "<img src=\"images\\Gold.png\"> Gold: 100",
      "lvl2cost": "<img src=\"images\\Gold.png\"> Gold: 300",
      "lvl3cost": "<img src=\"images\\Gold.png\"> Gold: 800 <br> <img src=\"images\\Dark Crystal.png\"> Dark Crystal: 1"
