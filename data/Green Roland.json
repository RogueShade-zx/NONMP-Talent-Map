    {
      "id": 5501,
      "name": "Starbreaker Shot",
      "type": "Common",
      "state": "LightUp",
      "x": 157.99998,
      "y": -253.99998,
      "image": "Starbreaker Shot.png",
      "Desc": "*After combat begins, this skill enters Cooldown.<br><br>Concentrate the magic bow's power into a devastating shot. Stuns the first target hit, dealing Physical DMG equal to 300% ATK.<br>Stun lasts 1 turn.<br>Pierces through, damaging all units behind. Damage decreases by 100% per unit pierced.<br>",
      "NumericDesc": "Damage Decay per Unit：100%<br>Range：2,3,4<br>Physical DMG ATK %：300% / 400% / 500%<br>Cooldown：4turns.<br>Sanity Cost：100 / 150 / 200",
      "Story": "Green Roland gradually draws the bow to full, then releases—the arrow surges into the enemy ranks like a meteor—<br>\"As long as the first arrow hits hard—like life, solve the biggest problem first and the rest is easy.\"",
      "lvl1cost": "<img src=\"images\\Gold.png\"> Gold: 100",
      "lvl2cost": "<img src=\"images\\Gold.png\"> Gold: 300",
      "lvl3cost": "<img src=\"images\\Gold.png\"> Gold: 800 <br> <img src=\"images\\Dark Crystal.png\"> Dark Crystal: 1"
    },
    {
      "id": 5401,
      "name": "Tracking Arrow Formation",
      "type": "Common",
      "state": "LightUp",
      "x": 264.99997,
      "y": -150,
      "image": "Tracking Arrow Formation.png",
      "Desc": "Rain arrows on the target area, dealing Physical DMG equal to 50% ATK to all in range. On crit, apply \"Startled\" for 2 turns.<br><br>\"Startled\"<br>When displaced, Green Roland immediately fires \"Cold Arrow\" at this target (ignores range, no Sanity cost).<br>",
      "NumericDesc": "Range：3,4<br>ATK DMG：50% / 75% / 100%<br>Cooldown：2turns.<br>Sanity Cost：25 / 35 / 50",
      "Story": "The rain of arrows hangs in the air for a moment before pouring down, pinning into the ground—<br>\"Whew, holding this many arrows at once is still a bit difficult... Looks like I need more practice.\"",
      "lvl1cost": "<img src=\"images\\Gold.png\"> Gold: 100",
      "lvl2cost": "<img src=\"images\\Gold.png\"> Gold: 300",
      "lvl3cost": "<img src=\"images\\Gold.png\"> Gold: 800 <br> <img src=\"images\\Dark Crystal.png\"> Dark Crystal: 1"
    },
    {
      "id": 5301,
      "name": "Hunter's Heart",
      "type": "Common",
      "state": "LightUp",
      "x": 304.99997,
      "y": -23,
      "image": "Hunter's Heart.png",
      "Desc": "Aim for a vital point, dealing Physical DMG equal to 150% ATK.<br>If crit and target is Bleeding, immediately trigger Bleed damage without removing the stacks.<br>",
      "NumericDesc": "Range：2,3,4<br>ATK DMG：150% / 170% / 190%<br>Cooldown：2turns.<br>Sanity Cost：30 / 40 / 50",
      "Story": "The moment the arrow flies, everything around seems to pause.<br>\"Gotta let the prey bleed slowly to keep up.\"",
      "lvl1cost": "<img src=\"images\\Gold.png\"> Gold: 100",
      "lvl2cost": "<img src=\"images\\Gold.png\"> Gold: 300",
      "lvl3cost": "<img src=\"images\\Gold.png\"> Gold: 800 <br> <img src=\"images\\Dark Crystal.png\"> Dark Crystal: 1"
    },
