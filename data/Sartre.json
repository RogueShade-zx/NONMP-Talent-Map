    {
      "id": 3501,
      "name": "Energy Surge",
      "type": "Common",
      "state": "LightUp",
      "x": 157.99998,
      "y": -253.99998,
      "image": "Energy Surge.png",
      "Desc": "*After combat begins, this skill enters Cooldown.<br><br>Usable only when enemies with \"Arcane Rift\" exist.<br>Sartre detonates all \"Arcane Rift\" stacks, dealing Magic DMG to each enemy based on their stacks. Base Magic DMG is 100% / 150% / 200% ATK, with additional 3% / 5% / 7% ATK damage per stack.<br>\"Energy Surge\" pushes Sartre back 2 units and immediately enters \"Zzz\" state.<br>",
      "NumericDesc": "Base DMG ATK %：100% / 150% / 200%<br>Bonus DMG ATK %：3% / 5% / 7%<br>Cooldown：5 turns<br>Sanity Cost：10 / 20 / 30",
      "Story": "This is Sartre's magnum opus—burning all research into \"perfect\" techno-magic—<br>\"A bunch of people bullying a little girl? Hmph, but this little girl is bullying YOU!\"",
      "lvl1cost": "<img src=\"images\\Gold.png\"> Gold: 100",
      "lvl2cost": "<img src=\"images\\Gold.png\"> Gold: 300",
      "lvl3cost": "<img src=\"images\\Gold.png\"> Gold: 800 <br> <img src=\"images\\Dark Crystal.png\"> Dark Crystal: 1"
    },
    {
      "id": 3401,
      "name": "Magic Artillery",
      "type": "Common",
      "state": "LightUp",
      "x": 264.99997,
      "y": -150,
      "image": "Magic Artillery.png",
      "Desc": "Select an enemy to fire magic artillery, dealing Magic DMG equal to 100% / 140% / 180% ATK to the main target, and Magic DMG equal to 60% / 80% / 100% ATK to adjacent units.<br>",
      "NumericDesc": "Range：2,3,4<br>Main Target ATK DMG：100% / 140% / 180%<br>Adjacent Target ATK DMG：60% / 80% / 100%<br>Cooldown：2 turns<br>Sanity Cost：25 / 35 / 50",
      "Story": "Little Sartre can pull out her magic cannon anywhere—though not every place can handle it. You've lost count of the damages paid.<br>\"Ugh, the trajectory's off again—where's the problem?!\"",
      "lvl1cost": "<img src=\"images\\Gold.png\"> Gold: 100",
      "lvl2cost": "<img src=\"images\\Gold.png\"> Gold: 300",
      "lvl3cost": "<img src=\"images\\Gold.png\"> Gold: 800 <br> <img src=\"images\\Dark Crystal.png\"> Dark Crystal: 1"
    },
    {
      "id": 3301,
      "name": "Zzz Plan!",
      "type": "Common",
      "state": "LightUp",
      "x": 304.99997,
      "y": -23,
      "image": "Zzz Plan!.png",
      "Desc": "Sartre covers herself with a blanket and starts sleeping, entering \"Zzz\" state for 1 turn.<br><br>\"Zzz\" State<br>Self is afflicted with \"Stun\".<br>If Sartre receives no damage or control effects during this state, restore 20% / 25% / 30% of max Sanity and HP upon exiting.<br>If any damage is received, \"Zzz\" state ends early and Sartre's morning grumpiness kicks in, increasing own ATK by 20% / 25% / 30% until end of next turn.<br>If any control effect is received, skill effect immediately ends without effect.",
      "NumericDesc": "Max Sanity Recovery：20% / 25% / 30%<br>Max HP Recovery：20% / 25% / 30%<br>ATK Increase：20% / 25% / 30%<br>Cooldown：3 turns<br>Sanity Cost：0",
      "Story": "Never wake a sleeping Dr. Sartre—terrible things happen...<br>\"Whatever it is, wait until I wake up!\"",
      "lvl1cost": "<img src=\"images\\Gold.png\"> Gold: 100",
      "lvl2cost": "<img src=\"images\\Gold.png\"> Gold: 300",
      "lvl3cost": "<img src=\"images\\Gold.png\"> Gold: 800 <br> <img src=\"images\\Dark Crystal.png\"> Dark Crystal: 1"
    },
